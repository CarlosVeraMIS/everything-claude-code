# Azure AD Configuration (Power BI Authentication)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Power BI Configuration
PBI_WORKSPACE_ID=your-workspace-id
PBI_API_URL=https://api.powerbi.com/v1.0/myorg

# Application Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/health-check.db
DATABASE_URL=sqlite:./data/health-check.db

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# OneLake Configuration (Future)
ONELAKE_ACCOUNT_NAME=your-account
ONELAKE_WORKSPACE_ID=your-workspace
ONELAKE_CAPACITY_ID=your-capacity

# Feature Flags
FEATURE_REAL_EXTRACTION=false
FEATURE_AUTO_SCHEDULING=false
FEATURE_FABRIC_INTEGRATION=false

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Analysis Configuration
HEALTH_SCORE_MEMORY_THRESHOLD=256
HEALTH_SCORE_WEIGHTS={"memory":0.30,"density":0.20,"dax":0.20,"query":0.15,"refresh":0.10,"rls":0.05}
